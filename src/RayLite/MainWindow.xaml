<Window x:Class="RayLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RayLite"
        Icon="app.ico"
        Width="680"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2D2F38" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#FF24262D" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#FF1C1D22"
            BorderBrush="#FF34363F"
            BorderThickness="1">
        <StackPanel>

            <Grid Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="#FF8B8E99"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />

                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22"
                             Background="Transparent"
                             Foreground="#FFF2F3F5"
                             CaretBrush="#FFF2F3F5"
                             BorderThickness="0"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             SpellCheck.IsEnabled="False">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Down" Command="{Binding MoveDownCommand}" />
                            <KeyBinding Key="Up" Command="{Binding MoveUpCommand}" />
                            <KeyBinding Key="Return" Command="{Binding ExecuteCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Text="Search apps and files…"
                               FontSize="22"
                               Foreground="#FF5F626E"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Query}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Border Height="1" Background="#FF2C2E36"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" />

            <ListBox x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="8,8,8,8"
                     Focusable="False"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                     PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Icon}"
                                   Width="28" Height="28"
                                   Margin="10,0,14,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           Foreground="#FFF2F3F5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="11.5"
                                           Foreground="#FF7F8290"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding TypeLabel}"
                                       FontSize="12"
                                       Foreground="#FF7F8290"
                                       VerticalAlignment="Center"
                                       Margin="12,0,12,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No results"
                       Foreground="#FF7F8290"
                       FontSize="14"
                       Margin="22,0,22,16"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
