<Window x:Class="RayLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RayLite Settings"
        Icon="app.ico"
        Width="540" Height="700"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1C1D22"
        Foreground="#FFE9EAEE"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF26272D" />
            <Setter Property="Foreground" Value="#FFE9EAEE" />
            <Setter Property="CaretBrush" Value="#FFE9EAEE" />
            <Setter Property="BorderBrush" Value="#FF3A3C45" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D2F38" />
            <Setter Property="Foreground" Value="#FFE9EAEE" />
            <Setter Property="BorderBrush" Value="#FF3A3C45" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF26272D" />
            <Setter Property="Foreground" Value="#FFE9EAEE" />
            <Setter Property="BorderBrush" Value="#FF3A3C45" />
            <Setter Property="Height" Value="90" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8B8E99" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,12,24,20">

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" Foreground="#FFFF7B72" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Margin="0" />
            </StackPanel>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Hotkey" Style="{StaticResource Heading}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetHotkeyCommand}" Margin="8,0,0,0" />
                <TextBox x:Name="HotkeyBox"
                         Text="{Binding Hotkey, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Click the box and press the new key combination (e.g. Ctrl+Space, Ctrl+Shift+K)." />

            <TextBlock Text="General" Style="{StaticResource Heading}" />
            <CheckBox Content="Run RayLite when Windows starts" IsChecked="{Binding RunOnStartup}" />
            <CheckBox Content="Disable hotkey in fullscreen apps / games" IsChecked="{Binding IgnoreFullscreen}" />

            <TextBlock Text="Search folders" Style="{StaticResource Heading}" />
            <CheckBox Content="Index Documents, Desktop and Downloads" IsChecked="{Binding IndexDefaultFolders}" Margin="0,0,0,8" />
            <TextBlock Text="Additional folders to include" Style="{StaticResource Hint}" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding IncludedFolders}" SelectedItem="{Binding SelectedIncluded}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add folder…" Command="{Binding AddIncludedCommand}" />
                <Button Content="Remove" Command="{Binding RemoveIncludedCommand}" />
            </StackPanel>

            <TextBlock Text="Excluded folders" Style="{StaticResource Heading}" />
            <ListBox ItemsSource="{Binding ExcludedFolders}" SelectedItem="{Binding SelectedExcluded}" />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveExclusionCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseExclusionCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddExclusionCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Enter a folder name (e.g. node_modules) to exclude it everywhere, or a full path to exclude one location." />

            <TextBlock Text="Index size limit" Style="{StaticResource Heading}" />
            <TextBox Text="{Binding MaxIndexedFiles}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Maximum number of files and folders kept in memory (1,000 – 200,000). Lower values use less RAM." />
        </StackPanel>
    </DockPanel>
</Window>
